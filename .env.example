# ---------- Sign in ----------
# Long random string that signs login cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------- Voice ----------
ELEVENLABS_API_KEY=
# Leave empty to use a built in voice. Free plans cannot use library voices through the API.
ELEVENLABS_VOICE_ID=

# ---------- Brain (xAI Grok) ----------
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# ---------- Gemini Prediction Markets ----------
# Market data is public. Keys only needed for live orders.
GEMINI_API_KEY=
GEMINI_API_SECRET=
GEMINI_BASE_URL=https://api.gemini.com
# paper = simulate fills at the live ask. live = send real signed orders.
GEMINI_MODE=paper

# ---------- Solana (devnet) ----------
SOLANA_RPC_URL=https://api.devnet.solana.com
# Run: npm run wallet  (creates data/agent-wallet.json)
SOLANA_AGENT_SECRET=
# Devnet USDC mint from Circle
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Where staked USDC goes (escrow / vault wallet). Defaults to agent wallet self transfer.
ESCROW_WALLET=

# ---------- QuickNode Streams ----------
# Set your Stream destination to https://YOUR_HOST/api/streams?token=THIS_VALUE
QUICKNODE_STREAM_TOKEN=change-me

# ---------- X alerts (Grok bot) ----------
# OAuth 2.0 user access token with tweet.write scope
X_USER_ACCESS_TOKEN=
